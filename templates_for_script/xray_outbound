{
  "tag": "default",
  "protocol": "vless",
  "settings": {
    "address": "$VLESS_DOMAIN",
    "port": $XRAY_PORT,
    "id": "$XRAY_UUID",
    "encryption": "none"
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "reality",
    "xhttpSettings": {
      "path": "/$XHTTP_PATH",
      "mode": "stream-one"
    },
    "realitySettings": {
      "serverName": "$VLESS_DOMAIN",
      "fingerprint": "firefox",
      "publicKey": "$XRAY_PBK",
      "shortId": "$XRAY_SID",
      "spiderX": "/"
    }
  }
}
